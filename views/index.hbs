<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}}</title>
    <!-- Bootstrap CSS -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
        crossorigin="anonymous"
    >
    </head>
    <body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-lg text-center style="max-width: 500px; border: none;">
        <div class="card-header bg-primary text-white">
        <h2 class="m-0 fs-4">{{titulo}}</h2>
        </div>
        
        <div class="card-body p-4">
        <p class="card-text fs-5">{{mensaje}}</p>
        
        <p class="mb-3">
            Estado del servidor: 
            <span class="badge bg-success fs-6">{{estado}}</span>
        </p>

        <hr class="my-4">
        <a href="/" class="btn btn-primary">Ir a Vista Estática</a>
        <a href="/status" class="btn btn-outline-primary btn-sm">
            Ver API Status (JSON)
        </a>
        </div>

        <div class="card-footer text-muted small">
        Vista dinámicamente renderizada con HBS.
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script 
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
        crossorigin="anonymous">
    </script>
</body>
</html>